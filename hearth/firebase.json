{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "*.md",
      "companions/**",
      "*.bat",
      "scripts/**"
    ],
    "rewrites": [
      {
        "source": "/api/hearth",
        "function": "hearth"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|html)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "functions": {
    "source": "functions",
    "predeploy": [
      "node scripts/prepare-functions.js"
    ]
  }
}