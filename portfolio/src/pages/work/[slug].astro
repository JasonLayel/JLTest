---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ImageSlot from '../../components/ImageSlot.astro';

export async function getStaticPaths() {
  const work = await getCollection('work');
  // PHASE 2: only build case-study pages that have real content. While an
  // entry is still a slot (isSlot: true), it stays hidden, no orphan page.
  // Flip isSlot to false in the .md file and the page builds automatically.
  return work
    .filter((entry) => !entry.data.isSlot)
    .map((entry) => ({
      params: { slug: entry.id },
      props: { entry },
    }));
}

const { entry } = Astro.props;
const { title, category, summary, year, role, tools, hero, heroAlt, isSlot } =
  entry.data;
const { Content } = await render(entry);
const home = import.meta.env.BASE_URL;
---

<Base title={`${title} | Jason Layel`} description={summary}>
  <article class="wrap">
    <header class="cs-head">
      <a class="arrow-link back" href={`${home}#work`}>&#8592; All work</a>
      <p class="kicker"><b>{category}</b>{isSlot && ' · content slot'}</p>
      <h1>{title}</h1>
      <p class="lede muted">{summary}</p>
    </header>

    <ImageSlot
      src={hero}
      alt={heroAlt || title}
      ratio="21 / 9"
      hint="Full-bleed hero image, min 2400px wide"
      sizes="100vw"
      loading="eager"
    />

    <div class="cs-body">
      <aside class="cs-meta">
        <div>
          <span class="kicker">Role</span>
          <p>{role || 'TBD'}</p>
        </div>
        <div>
          <span class="kicker">Year</span>
          <p>{year || 'TBD'}</p>
        </div>
        <div>
          <span class="kicker">Tools</span>
          <p>{tools.length ? tools.join(', ') : 'TBD'}</p>
        </div>
      </aside>
      <div class="cs-content">
        <Content />
      </div>
    </div>
  </article>
</Base>

<style>
  article {
    padding-block: clamp(3rem, 8vw, 6rem);
  }

  .cs-head {
    display: grid;
    gap: 1rem;
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
    max-width: 52rem;
  }

  .back {
    margin-bottom: 1rem;
  }

  .back::after {
    content: none;
  }

  h1 {
    font-size: var(--step-3);
    text-transform: uppercase;
  }

  .cs-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 3fr);
    gap: clamp(2rem, 5vw, 4rem);
    margin-top: clamp(2rem, 5vw, 3.5rem);
  }

  @media (max-width: 48rem) {
    .cs-body {
      grid-template-columns: 1fr;
    }
  }

  .cs-meta {
    display: grid;
    gap: 1.5rem;
    align-content: start;
    position: sticky;
    top: 6rem;
  }

  .cs-meta p {
    margin-top: 0.25rem;
  }

  .cs-content {
    display: grid;
    gap: 1.5rem;
    max-width: var(--measure);
  }

  .cs-content :global(p) {
    text-wrap: pretty;
  }

  .cs-content :global(h2) {
    font-size: var(--step-1);
    margin-top: 1rem;
  }

  .cs-content :global(img) {
    border-radius: 2px;
  }
</style>
