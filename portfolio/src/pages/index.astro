---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import WorkCard from '../components/WorkCard.astro';
import StillsGallery from '../components/StillsGallery.astro';
import VimeoFilm from '../components/VimeoFilm.astro';

// Hero backdrop — swap the stem to feature a different still up top
// (keep it in sync with EXCLUDED in StillsGallery.astro).
const heroFiles = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/stills/tree-art-final-small.{jpg,jpeg,png,webp}',
  { eager: true }
);
const heroImage = Object.values(heroFiles)[0]?.default ?? null;

// About photos — drop files into src/assets/about/ and the About section
// switches to a two-column layout with the portrait (and optional family
// photo). Absent → About stays single-column text, no placeholders.
const aboutFiles = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/about/*.{jpg,jpeg,png,webp,avif}',
  { eager: true }
);
const aboutImg = (stem: string) =>
  Object.entries(aboutFiles).find(([p]) =>
    p.toLowerCase().includes(`/about/${stem}.`)
  )?.[1].default ?? null;
const portrait = aboutImg('portrait');
const family = aboutImg('family');

const work = (await getCollection('work')).sort(
  (a, b) => a.data.order - b.data.order
);

const tools = [
  '3ds Max + V-Ray / Redshift / Arnold',
  'Unreal Engine 5',
  'Blender',
  'Enscape / Twinmotion / Lumion',
  'Revit + AutoCAD',
  'Rhino / Grasshopper',
  'Adobe Suite',
  'DaVinci Resolve',
];

const capabilities = [
  {
    name: '3D Rendering',
    text: 'Stills that hold up under a client’s longest stare. Pursuit imagery, marketing packages, design studies — built from live design models, not one-off art files.',
  },
  {
    name: '3D Film Cinematics & Editing',
    text: 'Full direction from storyboard to final cut: narrative development, rendering, compositing, and editing for flagship project films.',
  },
  {
    name: 'VR/AR/XR',
    text: 'Design review you can stand inside. Full-scale walkthroughs for clients and project teams, from quick massing checks to polished headset experiences.',
  },
  {
    name: 'Interactive Experiences',
    text: 'Tools people actually pick up. Real-time experiences, configurators, and touch interfaces that let stakeholders explore a design on their own terms.',
  },
];
---

<Base
  title="Jason Layel — Design Visualization"
  description="Design Visualization Specialist with 14 years across architectural design and 3D visualization. 3D rendering, film cinematics, VR/AR/XR, and interactive experiences."
>
  <!-- HERO -->
  <section id="top" class="hero" data-parallax>
    {
      heroImage && (
        <Image
          class="hero-bg"
          src={heroImage}
          alt=""
          widths={[768, 1440, 2400]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
        />
      )
    }
    <div class="hero-inner wrap">
      <p class="kicker rise"><b>&#9679;</b> Design Visualization &mdash; 3D Rendering / Film Cinematics / VR&#8202;/&#8202;AR&#8202;/&#8202;XR / Interactive</p>
      <h1 class="display rise">Jason Layel</h1>
      <p class="lede rise-late">I bring architecture and environments to life.</p>
      <div class="hero-sub rise-late">
        <p>
          My passion is telling compelling stories and building deeply immersive
          experiences that evoke awe, a sense of beauty, and an understanding of
          design — through the use of visualization technology.
        </p>
        <p>
          Fourteen years of experience across architectural design and 3D
          visualization. Currently leading the Visualization Technology
          department at MG2, a ~450-person architecture firm, where I direct
          enterprise-wide workflows and support our staff while personally
          visualizing our most demanding flagship projects.
        </p>
      </div>
      <div class="hero-links rise-late">
        <a class="arrow-link" href="#stills">See the work</a>
        <a class="arrow-link" href="#contact">Get in touch</a>
      </div>
    </div>
  </section>

  <!-- STILLS -->
  <section id="stills" class="section wrap">
    <div class="section-head">
      <h2>Stills</h2>
      <p class="kicker">Selected renderings</p>
    </div>
    <StillsGallery />
  </section>

  <!-- CINEMATICS -->
  <section id="cinematics" class="section wrap">
    <div class="section-head">
      <h2>Cinematics</h2>
      <p class="kicker">Film &amp; animation</p>
    </div>
    <VimeoFilm
      vimeoId="376264569"
      title="Featured film"
      poster="stills/film-frame-forest-tower.png"
    />
  </section>

  {/* PHASE 2 — XR / VR / AR. Hidden until a real video lands (end of week).
     Restore this section and its nav link (Nav.astro) then, and give the
     VimeoFilm a `vimeoId` and `poster`:

  <section id="immersive" class="section wrap">
    <div class="section-head">
      <h2>XR / VR / AR</h2>
      <p class="kicker">Immersive and real-time</p>
    </div>
    <VimeoFilm vimeoId="..." title="Immersive experience" poster="stills/....png" />
  </section>
  */}

  <!-- CAPABILITIES -->
  <section id="capabilities" class="section wrap">
    <div class="section-head">
      <h2>Capabilities</h2>
      <p class="kicker">One person, full pipeline</p>
    </div>
    <div class="cap-grid">
      {
        capabilities.map((cap, i) => (
          <div class="cap">
            <span class="kicker">{String(i + 1).padStart(2, '0')}</span>
            <h3>{cap.name}</h3>
            <p class="muted">{cap.text}</p>
          </div>
        ))
      }
    </div>
    <ul class="tool-strip" aria-label="Software and tools">
      {tools.map((t) => <li>{t}</li>)}
    </ul>
  </section>

  {/* PHASE 2 — Work / case studies. Hidden until the case studies are
     written (WorkCard + content/work/*.md are all kept ready). Restore this
     section and its nav link (Nav.astro) then:

  <section id="work" class="section wrap">
    <div class="section-head">
      <h2>Work</h2>
      <p class="kicker">Case studies</p>
    </div>
    <div class="work-grid">
      {work.map((entry, i) => <WorkCard entry={entry} index={i} />)}
    </div>
  </section>
  */}

  <!-- ABOUT -->
  <section id="about" class="section wrap">
    <div class="section-head">
      <h2>About</h2>
      <p class="kicker">Background</p>
    </div>
    <div class:list={['about-body', { 'about-grid': portrait }]}>
      <div class="about-text">
        <p>
          I founded and run the visualization department at MG2, a 450-person
          architecture firm, as its sole practitioner — turning live design
          models into the renderings, films, and immersive experiences that win
          pursuits and move review boards.
        </p>
        <p>
          I'm a licensed-track architect (Master of Architecture, University of
          Virginia) who spent years as a project architect before specializing,
          which is why the work reads as buildings, not backdrops. I build
          visualization pipelines end to end, set the art-direction and QA
          standards behind 100+ deliverables a year, and scale them across the
          firm — authoring training in seven tools for 300+ designers and
          running VR design reviews across six offices.
        </p>
        <p>
          The full background lives in the <a class="underline-link" href={`${import.meta.env.BASE_URL}jason-layel-resume.pdf`}>resume (PDF)</a>.
        </p>
      </div>
      {
        portrait && (
          <div class="about-media">
            <figure class="frame portrait">
              <Image
                src={portrait}
                alt="Jason Layel"
                widths={[400, 800, 1100]}
                sizes="(max-width: 48rem) 100vw, 40vw"
              />
            </figure>
            {family && (
              <figure class="frame family">
                <Image
                  src={family}
                  alt="Jason Layel with his family"
                  widths={[600, 1200, 1800]}
                  sizes="(max-width: 48rem) 100vw, 40vw"
                />
              </figure>
            )}
          </div>
        )
      }
    </div>
  </section>

  <!-- CONTACT -->
  <section id="contact" class="section wrap">
    <div class="section-head">
      <h2>Contact</h2>
      <p class="kicker">Currently at MG2 &middot; open to the right role</p>
    </div>
    <p class="lede">
      If you&rsquo;re hiring for a design visualization or visualization
      leadership role &mdash; or building a team and want to talk about how one
      dedicated specialist raised the bar across an entire firm &mdash;
      I&rsquo;d welcome the conversation. The fastest way to reach me:
    </p>
    <a class="big-mail" href="mailto:jason.layel@gmail.com">jason.layel@gmail.com</a>
    <div class="contact-links">
      <a class="arrow-link" href={`${import.meta.env.BASE_URL}jason-layel-resume.pdf`}>Download resume</a>
      <a class="arrow-link" href="https://www.linkedin.com/in/jasonlayel" rel="me">LinkedIn</a>
      <a class="arrow-link" href="https://www.artstation.com/jasonlayel" rel="me">ArtStation</a>
      <a class="arrow-link" href="https://www.behance.net/jasonlayel" rel="me">Behance</a>
    </div>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    display: grid;
    align-content: end;
    min-height: clamp(26rem, 50vw, 46rem);
    overflow: hidden;
  }

  .hero :global(.hero-bg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
    /* parallax + zoom is driven by --p (0 at top → 1 when hero scrolled past),
       set by a scroll listener; falls back to a static image if JS/motion off */
    transform: scale(calc(1 + var(--p, 0) * 0.18))
      translateY(calc(var(--p, 0) * 4vh));
    transform-origin: 50% 42%;
    will-change: transform;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero :global(.hero-bg) {
      transform: none;
    }
  }

  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      to bottom,
      rgba(12, 12, 13, 0.35),
      rgba(12, 12, 13, 0.55) 55%,
      rgba(12, 12, 13, 0.94)
    );
  }

  .hero-inner {
    display: grid;
    gap: clamp(0.9rem, 2vw, 1.25rem);
    width: 100%;
    padding-block: clamp(2rem, 5vw, 3.5rem);
  }

  .hero .display {
    font-size: clamp(2rem, 1.4rem + 3vw, 3.8rem);
  }

  .hero .kicker {
    color: #d8d6d0;
  }

  .hero-sub {
    display: grid;
    gap: 0.85rem;
    max-width: var(--measure);
  }

  .hero-sub p {
    font-size: var(--step-0);
    line-height: 1.55;
  }

  .hero-links {
    display: flex;
    gap: 2.5rem;
    margin-top: 0.5rem;
  }

  .work-grid {
    display: block;
  }

  .cap-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(17rem, 100%), 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }

  .cap {
    background: var(--bg);
    padding: clamp(1.5rem, 3vw, 2.25rem);
    display: grid;
    gap: 0.75rem;
    align-content: start;
    transition: background 200ms ease;
  }

  .cap:hover {
    background: var(--bg-raised);
  }

  .cap h3 {
    font-size: var(--step-1);
  }

  .cap p {
    font-size: var(--step--1);
    line-height: 1.65;
  }

  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .about-text {
    display: grid;
    gap: 1.25rem;
    align-content: start;
    max-width: var(--measure);
  }

  .about-media {
    display: grid;
    gap: clamp(0.9rem, 2vw, 1.4rem);
    align-content: start;
    /* sticks alongside the text as it scrolls on wide screens */
    position: sticky;
    top: 6rem;
  }

  .about-media .frame {
    margin: 0;
    overflow: hidden;
    border-radius: 2px;
    background: var(--bg-raised);
    border: 1px solid var(--line);
  }

  .about-media .frame.portrait {
    aspect-ratio: 4 / 5;
  }

  .about-media .frame.family {
    aspect-ratio: 3 / 2;
  }

  .about-media .frame :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .about-media .frame.portrait :global(img) {
    object-position: 50% 32%;
  }

  @media (max-width: 48rem) {
    .about-grid {
      grid-template-columns: 1fr;
    }

    .about-media {
      position: static;
      max-width: 22rem;
    }
  }

  .big-mail {
    display: inline-block;
    margin-top: 1.5rem;
    font-size: var(--step-2);
    font-weight: 640;
    font-stretch: 118%;
    letter-spacing: -0.01em;
    background-image: linear-gradient(var(--accent), var(--accent));
    background-repeat: no-repeat;
    background-size: 100% 2px;
    background-position: 0 100%;
    padding-bottom: 4px;
    transition: color 160ms ease;
    word-break: break-all;
  }

  .big-mail:hover {
    color: var(--accent);
  }

  .contact-links {
    margin-top: 2.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 2.5rem;
  }

  .tool-strip {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 2.5rem;
  }

  .tool-strip li {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.04em;
    color: var(--ink-muted);
    border: 1px solid var(--line);
    border-radius: 2px;
    padding: 0.35rem 0.75rem;
    white-space: nowrap;
  }

  .timeline {
    display: grid;
    gap: 1.1rem;
    border-left: 1px solid var(--line);
    padding-left: 1.25rem;
    margin-block: 0.5rem;
  }

  .tl-row dt {
    color: var(--accent);
  }

  .tl-row dd {
    margin-top: 0.2rem;
    font-size: var(--step--1);
    line-height: 1.65;
    color: var(--ink-muted);
  }

  .film-placeholder {
    width: 100%;
  }
</style>

<script>
  // Scroll-driven parallax + zoom on the hero image. Sets --p from 0 (hero
  // fully in view) to 1 (hero fully scrolled past). rAF-throttled; disabled
  // when the viewer prefers reduced motion.
  const hero = document.querySelector<HTMLElement>('[data-parallax]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (hero && !reduce) {
    let ticking = false;
    const update = () => {
      const h = hero.offsetHeight || 1;
      const p = Math.min(1, Math.max(0, window.scrollY / h));
      hero.style.setProperty('--p', p.toFixed(4));
      ticking = false;
    };
    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };
    update();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', update, { passive: true });
  }
</script>
