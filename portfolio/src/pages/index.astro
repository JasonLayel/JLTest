---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import WorkCard from '../components/WorkCard.astro';
import ImageSlot from '../components/ImageSlot.astro';
import StillsGallery from '../components/StillsGallery.astro';

const work = (await getCollection('work')).sort(
  (a, b) => a.data.order - b.data.order
);

const tools = [
  '3ds Max + V-Ray / Redshift / Arnold',
  'Unreal Engine 5',
  'Blender',
  'Enscape / Twinmotion / Lumion',
  'Revit + AutoCAD',
  'Rhino / Grasshopper',
  'Adobe Suite',
  'DaVinci Resolve',
];

const timeline = [
  {
    years: '2005–12',
    what: 'Architecture school, twice over — B.Des at Florida (high honors), M.Arch at UVA. Learned to draw by hand and never really stopped: watercolor, charcoal, physical models.',
  },
  {
    years: '2013–14',
    what: 'Freelance 3D artist. Renderings and real-time assets in early Unreal and Unity, built from whatever clients had — sketches, CAD files, sometimes just a phone call.',
  },
  {
    years: '2014–18',
    what: 'Illustrate My Design. Started as a 3D artist, ended up managing a team of five across 100+ architecture and interiors projects.',
  },
  {
    years: '2018–22',
    what: 'MG2, architectural designer. Project Architect on retail and grocery work — Revit, code, permitting, construction admin. The years that make my renders read like buildings instead of backdrops.',
  },
  {
    years: '2022–now',
    what: 'MG2, Design Visualization Specialist. Built the firm’s end-to-end viz pipeline from scratch; art direction and QA standards across 100+ projects a year; training curricula for 300+ designers; a fleet of 15+ VR headsets across six offices.',
  },
];

const capabilities = [
  {
    name: '3D Rendering',
    text: 'Stills that hold up under a client’s longest stare. Pursuit imagery, marketing packages, design studies — built from live design models, not one-off art files.',
  },
  {
    name: '3D Film Cinematics & Editing',
    text: 'Full direction from storyboard to final cut: narrative development, rendering, compositing, and editing for flagship project films.',
  },
  {
    name: 'VR/AR/XR',
    text: 'Design review you can stand inside. Full-scale walkthroughs for clients and project teams, from quick massing checks to polished headset experiences.',
  },
  {
    name: 'Interactive Experiences',
    text: 'Tools people actually pick up. Real-time experiences, configurators, and touch interfaces that let stakeholders explore a design on their own terms.',
  },
];
---

<Base
  title="Jason Layel — Design Visualization"
  description="Design Visualization Specialist with 14 years across architectural design and 3D visualization. 3D rendering, film cinematics, VR/AR/XR, and interactive experiences."
>
  <!-- HERO -->
  <section id="top" class="hero wrap">
    <p class="kicker rise"><b>&#9679;</b> Design Visualization &mdash; 3D Rendering / Film Cinematics / VR&#8202;/&#8202;AR&#8202;/&#8202;XR / Interactive</p>
    <h1 class="display rise">Jason<br />Layel</h1>
    <p class="lede rise-late">
      I make unbuilt architecture feel real. Fourteen years across
      architectural design and 3D visualization &mdash; currently running the
      Visualization Technology practice at MG2, a 450-person architecture
      firm, as a department of one.
    </p>
    <div class="hero-links rise-late">
      <a class="arrow-link" href="#stills">See the work</a>
      <a class="arrow-link" href="#contact">Get in touch</a>
    </div>
  </section>

  <!-- STILLS -->
  <section id="stills" class="section wrap">
    <div class="section-head">
      <h2>Stills</h2>
      <p class="kicker">Selected renderings</p>
    </div>
    <StillsGallery />
  </section>

  <!-- CAPABILITIES -->
  <section id="capabilities" class="section wrap">
    <div class="section-head">
      <h2>Capabilities</h2>
      <p class="kicker">One person, full pipeline</p>
    </div>
    <div class="cap-grid">
      {
        capabilities.map((cap, i) => (
          <div class="cap">
            <span class="kicker">{String(i + 1).padStart(2, '0')}</span>
            <h3>{cap.name}</h3>
            <p class="muted">{cap.text}</p>
          </div>
        ))
      }
    </div>
    <ul class="tool-strip" aria-label="Software and tools">
      {tools.map((t) => <li>{t}</li>)}
    </ul>
  </section>

  <!-- WORK -->
  <section id="work" class="section wrap">
    <div class="section-head">
      <h2>Work</h2>
      <p class="kicker">Case studies</p>
    </div>
    <div class="work-grid">
      {work.map((entry, i) => <WorkCard entry={entry} index={i} />)}
    </div>
  </section>

  <!-- ABOUT -->
  <section id="about" class="section wrap">
    <div class="section-head">
      <h2>About</h2>
      <p class="kicker">The short version</p>
    </div>
    <div class="about-grid">
      <div class="about-text">
        <p class="lede">
          I started in architectural design and drifted toward the part of the
          job everyone else treated as a deliverable: the moment a client
          finally <em>sees</em> the building.
        </p>
        <p>
          Fourteen years later that moment is my whole job. At MG2 I run the
          Visualization Technology department solo &mdash; which means I&rsquo;m
          the strategy, the pipeline, and the person hitting render. 3D
          rendering, film cinematics and editing, VR/AR/XR, interactive
          experiences: if it helps someone understand a design before it
          exists, it comes through my desk.
        </p>
        <p>
          Coming from the design side means I read drawings, sit comfortably in
          design crits, and know which details sell a space &mdash; so the work
          reads as architecture, not just imagery.
        </p>
        <dl class="timeline">
          {
            timeline.map((t) => (
              <div class="tl-row">
                <dt class="kicker">{t.years}</dt>
                <dd>{t.what}</dd>
              </div>
            ))
          }
        </dl>
        <p>
          The formal version lives in the <a class="underline-link" href={`${import.meta.env.BASE_URL}jason-layel-resume.pdf`}>resume (PDF)</a>.
        </p>
      </div>
      <div class="about-side">
        <ImageSlot
          src="about/portrait.jpg"
          alt="Portrait of Jason Layel"
          ratio="4 / 5"
          hint="Portrait or working-at-desk photo, min 1200px wide"
        />
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section id="contact" class="section wrap">
    <div class="section-head">
      <h2>Contact</h2>
      <p class="kicker">Currently at MG2 &middot; open to conversations</p>
    </div>
    <p class="lede">
      Hiring for a visualization role, or need imagery for a project?
      Either way, the inbox is the same:
    </p>
    <a class="big-mail" href="mailto:jason.layel@gmail.com">jason.layel@gmail.com</a>
    <div class="contact-links">
      <a class="arrow-link" href="https://www.linkedin.com/in/jasonlayel" rel="me">LinkedIn</a>
      <a class="arrow-link" href="https://www.artstation.com/jasonlayel" rel="me">ArtStation</a>
      <a class="arrow-link" href={`${import.meta.env.BASE_URL}jason-layel-resume.pdf`}>Resume</a>
    </div>
  </section>
</Base>

<style>
  .hero {
    display: grid;
    gap: clamp(1rem, 2.5vw, 1.5rem);
    padding-block: clamp(3rem, 7vw, 5rem) clamp(2.5rem, 6vw, 4.5rem);
  }

  .hero .display {
    font-size: clamp(2.8rem, 2rem + 4vw, 5rem);
  }

  .hero-links {
    display: flex;
    gap: 2.5rem;
    margin-top: 0.5rem;
  }

  .work-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.5rem, 4vw, 3.5rem);
  }

  @media (max-width: 48rem) {
    .work-grid {
      grid-template-columns: 1fr;
    }
  }

  .cap-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(17rem, 100%), 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }

  .cap {
    background: var(--bg);
    padding: clamp(1.5rem, 3vw, 2.25rem);
    display: grid;
    gap: 0.75rem;
    align-content: start;
    transition: background 200ms ease;
  }

  .cap:hover {
    background: var(--bg-raised);
  }

  .cap h3 {
    font-size: var(--step-1);
  }

  .cap p {
    font-size: var(--step--1);
    line-height: 1.65;
  }

  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    gap: clamp(2rem, 5vw, 4rem);
  }

  .about-text {
    display: grid;
    gap: 1.25rem;
    align-content: start;
    max-width: var(--measure);
  }

  @media (max-width: 48rem) {
    .about-grid {
      grid-template-columns: 1fr;
    }
  }

  .big-mail {
    display: inline-block;
    margin-top: 1.5rem;
    font-size: var(--step-2);
    font-weight: 640;
    font-stretch: 118%;
    letter-spacing: -0.01em;
    background-image: linear-gradient(var(--accent), var(--accent));
    background-repeat: no-repeat;
    background-size: 100% 2px;
    background-position: 0 100%;
    padding-bottom: 4px;
    transition: color 160ms ease;
    word-break: break-all;
  }

  .big-mail:hover {
    color: var(--accent);
  }

  .contact-links {
    margin-top: 2.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 2.5rem;
  }

  .tool-strip {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 2.5rem;
  }

  .tool-strip li {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.04em;
    color: var(--ink-muted);
    border: 1px solid var(--line);
    border-radius: 2px;
    padding: 0.35rem 0.75rem;
    white-space: nowrap;
  }

  .timeline {
    display: grid;
    gap: 1.1rem;
    border-left: 1px solid var(--line);
    padding-left: 1.25rem;
    margin-block: 0.5rem;
  }

  .tl-row dt {
    color: var(--accent);
  }

  .tl-row dd {
    margin-top: 0.2rem;
    font-size: var(--step--1);
    line-height: 1.65;
    color: var(--ink-muted);
  }
</style>
