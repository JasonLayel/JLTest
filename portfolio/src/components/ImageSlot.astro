---
/**
 * Renders an optimized image if the file exists at src/assets/<src>,
 * otherwise renders a clearly-labeled slot showing exactly where to
 * drop the file. No code changes needed when the image lands.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: string; // path relative to src/assets, e.g. "work/tower-hero.jpg"
  alt: string;
  ratio?: string; // CSS aspect-ratio, e.g. "3 / 2"
  hint?: string; // what the image should show, displayed in the slot
  sizes?: string;
  loading?: 'lazy' | 'eager';
}

const {
  src,
  alt,
  ratio = '3 / 2',
  hint = '',
  sizes = '(max-width: 48rem) 100vw, 50vw',
  loading = 'lazy',
} = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/**/*.{jpg,jpeg,png,webp,avif}'
);
// Match on basename so any extension works (slot says .jpg, a .png is fine)
const stem = `/src/assets/${src.replace(/\.[^.]+$/, '')}.`;
const key = Object.keys(files).find((f) => f.startsWith(stem));
const image = key ? (await files[key]()).default : null;
---

<div class="img-frame" style={`aspect-ratio: ${ratio}`}>
  {
    image ? (
      <Image
        src={image}
        alt={alt}
        widths={[480, 960, 1600]}
        sizes={sizes}
        loading={loading}
      />
    ) : (
      <div class="img-slot">
        <span class="slot-tag">image slot</span>
        <span class="slot-path">src/assets/{src}</span>
        {hint && <span>{hint}</span>}
      </div>
    )
  }
</div>
