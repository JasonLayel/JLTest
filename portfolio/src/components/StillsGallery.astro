---
/**
 * Auto-populating gallery. Every image dropped into src/assets/stills/
 * appears here on the next build — no code changes. Pure imagery: no
 * visible captions; filenames still become alt text for accessibility
 * ("arts-center-dusk.jpg" → "Arts center dusk").
 *
 * Each thumbnail links to a full-size (capped 2560px) variant and opens
 * in a click-to-zoom lightbox. With JS off, the link still opens the
 * full image directly, so it degrades gracefully.
 *
 * FEATURED filename stems render full-width above the masonry grid.
 * EXCLUDED stems are used elsewhere on the page (e.g. the hero) and
 * skipped here.
 */
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const FEATURED: string[] = [];
const EXCLUDED = ['tree-art-final-small']; // page hero backdrop

const files = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/stills/*.{jpg,jpeg,png,webp,avif}',
  { eager: true }
);

const all = Object.entries(files).map(([path, mod]) => {
  const stem = path.split('/').pop()!.replace(/\.[^.]+$/, '').toLowerCase();
  const alt = stem.replaceAll('-', ' ').replace(/^./, (c) => c.toUpperCase());
  return { stem, image: mod.default, alt };
});

const visible = all.filter((s) => !EXCLUDED.includes(s.stem));
const featuredList = FEATURED.map((stem) =>
  visible.find((s) => s.stem === stem)
).filter((s) => s !== undefined);
const gridList = visible
  .filter((s) => !featuredList.includes(s))
  .sort((a, b) => a.stem.localeCompare(b.stem));

// A full-size (capped) variant for the click-to-zoom lightbox / no-JS link.
const withFull = async (s: { stem: string; image: ImageMetadata; alt: string }) => ({
  ...s,
  full: (await getImage({ src: s.image, width: Math.min(s.image.width, 2560) })).src,
});
const featured = await Promise.all(featuredList.map(withFull));
const grid = await Promise.all(gridList.map(withFull));
---

{
  visible.length ? (
    <>
      {featured.map(({ image, alt, full }) => (
        <a class="feature-link" href={full} data-lightbox aria-label={`View full size — ${alt}`}>
          <Image
            class="feature"
            src={image}
            alt={`Architectural rendering — ${alt}`}
            widths={[768, 1440, 2400]}
            sizes="100vw"
          />
        </a>
      ))}
      <div class="stills">
        {grid.map(({ image, alt, full }) => (
          <a class="still-link" href={full} data-lightbox aria-label={`View full size — ${alt}`}>
            <Image
              src={image}
              alt={`Architectural rendering — ${alt}`}
              widths={[480, 960, 1600]}
              sizes="(max-width: 48rem) 100vw, 33vw"
            />
          </a>
        ))}
      </div>
      <div class="lightbox" data-lightbox-overlay hidden>
        <button class="lightbox-close" type="button" aria-label="Close">&times;</button>
        <img class="lightbox-img" alt="" />
      </div>
    </>
  ) : (
    <div class="slot">
      <strong>Stills gallery.</strong> Drop rendering files into
      src/assets/stills/ — every image there shows up here automatically on
      the next build.
    </div>
  )
}

<script>
  // Click-to-zoom lightbox. Progressive enhancement: the links work as
  // plain full-image links if this never runs.
  const overlay = document.querySelector<HTMLElement>('[data-lightbox-overlay]');
  const overlayImg = overlay?.querySelector<HTMLImageElement>('.lightbox-img');

  if (overlay && overlayImg) {
    const open = (src: string, alt: string) => {
      overlayImg.src = src;
      overlayImg.alt = alt;
      overlay.hidden = false;
      document.body.style.overflow = 'hidden';
    };
    const close = () => {
      overlay.hidden = true;
      overlayImg.src = '';
      document.body.style.overflow = '';
    };

    for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-lightbox]')) {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        open(link.href, link.querySelector('img')?.alt ?? '');
      });
    }
    overlay.addEventListener('click', close);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !overlay.hidden) close();
    });
  }
</script>

<style>
  .feature-link,
  .still-link {
    display: block;
    cursor: zoom-in;
    border-radius: 2px;
    overflow: hidden;
  }

  .feature-link {
    margin-bottom: clamp(1rem, 2vw, 1.5rem);
  }

  :global(img.feature) {
    width: 100%;
    height: auto;
  }

  .stills {
    columns: 3;
    gap: clamp(1rem, 2vw, 1.5rem);
  }

  @media (max-width: 64rem) {
    .stills {
      columns: 2;
    }
  }

  @media (max-width: 40rem) {
    .stills {
      columns: 1;
    }
  }

  .stills .still-link {
    break-inside: avoid;
    margin-bottom: clamp(1rem, 2vw, 1.5rem);
  }

  .feature-link :global(img),
  .stills :global(img) {
    display: block;
    width: 100%;
    height: auto;
    transition: opacity 200ms ease;
  }

  .feature-link:hover :global(img),
  .still-link:hover :global(img) {
    opacity: 0.85;
  }

  /* --- lightbox --- */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-content: center;
    padding: clamp(1rem, 4vw, 3rem);
    background: rgba(8, 8, 9, 0.92);
    cursor: zoom-out;
  }

  .lightbox[hidden] {
    display: none;
  }

  .lightbox-img {
    max-width: 100%;
    max-height: 88vh;
    width: auto;
    height: auto;
    border-radius: 2px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
  }

  .lightbox-close {
    position: absolute;
    top: clamp(0.75rem, 2vw, 1.5rem);
    right: clamp(0.75rem, 2vw, 1.5rem);
    width: 2.75rem;
    height: 2.75rem;
    display: grid;
    place-content: center;
    border: 1px solid var(--line);
    background: rgba(12, 12, 13, 0.6);
    color: var(--ink);
    font-size: 1.6rem;
    line-height: 1;
    border-radius: 50%;
    cursor: pointer;
    transition: color 160ms ease, border-color 160ms ease;
  }

  .lightbox-close:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
</style>
