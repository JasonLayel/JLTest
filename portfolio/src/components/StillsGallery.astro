---
/**
 * Auto-populating gallery. Every image dropped into src/assets/stills/
 * appears here on the next build — no code changes. Filenames become
 * captions/alt text: "arts-center-dusk.jpg" → "Arts center dusk".
 *
 * Filenames listed in FEATURED render full-width (in list order, above
 * the masonry grid). Add a stem here to promote an image to hero size.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const FEATURED = ['arts-center-dusk', 'tree-art-final-small'];

const files = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/stills/*.{jpg,jpeg,png,webp,avif}',
  { eager: true }
);

const all = Object.entries(files).map(([path, mod]) => {
  const stem = path.split('/').pop()!.replace(/\.[^.]+$/, '');
  const caption = stem.replaceAll('-', ' ').replace(/^./, (c) => c.toUpperCase());
  return { stem, image: mod.default, caption };
});

const featured = FEATURED.map((stem) =>
  all.find((s) => s.stem.toLowerCase() === stem)
).filter((s) => s !== undefined);

const grid = all
  .filter((s) => !featured.includes(s))
  .sort((a, b) => a.stem.localeCompare(b.stem));
---

{
  all.length ? (
    <>
      {featured.map(({ image, caption }, i) => (
        <figure class="feature">
          <Image
            src={image}
            alt={`Architectural rendering — ${caption}`}
            widths={[768, 1440, 2400]}
            sizes="100vw"
            loading={i === 0 ? 'eager' : 'lazy'}
          />
          <figcaption class="kicker">{caption}</figcaption>
        </figure>
      ))}
      <div class="stills">
        {grid.map(({ image, caption }) => (
          <figure>
            <Image
              src={image}
              alt={`Architectural rendering — ${caption}`}
              widths={[480, 960, 1600]}
              sizes="(max-width: 48rem) 100vw, 33vw"
            />
            <figcaption class="kicker">{caption}</figcaption>
          </figure>
        ))}
      </div>
    </>
  ) : (
    <div class="slot">
      <strong>Stills gallery.</strong> Drop rendering files into
      src/assets/stills/ — every image there shows up here automatically on
      the next build. Use descriptive kebab-case filenames; they become the
      captions.
    </div>
  )
}

<style>
  .feature {
    margin: 0 0 clamp(1.5rem, 3vw, 2.5rem);
  }

  .feature :global(img) {
    width: 100%;
    height: auto;
    border-radius: 2px;
  }

  .stills {
    columns: 3;
    gap: clamp(1rem, 2vw, 1.5rem);
  }

  @media (max-width: 64rem) {
    .stills {
      columns: 2;
    }
  }

  @media (max-width: 40rem) {
    .stills {
      columns: 1;
    }
  }

  .stills figure {
    break-inside: avoid;
    margin: 0 0 clamp(1rem, 2vw, 1.5rem);
  }

  .stills figure :global(img) {
    width: 100%;
    height: auto;
    border-radius: 2px;
  }

  figcaption {
    margin-top: 0.5rem;
    font-size: 0.72rem;
  }
</style>
