---
/**
 * Auto-populating gallery. Every image dropped into src/assets/stills/
 * appears here on the next build — no code changes. Filenames become
 * captions/alt text: "arts-center-dusk.jpg" → "Arts center dusk".
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const files = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/stills/*.{jpg,jpeg,png,webp,avif}',
  { eager: true }
);

const stills = Object.entries(files)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([path, mod]) => {
    const name = path.split('/').pop()!.replace(/\.[^.]+$/, '');
    const caption = name.replaceAll('-', ' ').replace(/^./, (c) => c.toUpperCase());
    return { image: mod.default, caption };
  });
---

{
  stills.length ? (
    <div class="stills">
      {stills.map(({ image, caption }) => (
        <figure>
          <Image
            src={image}
            alt={`Architectural rendering — ${caption}`}
            widths={[480, 960, 1600]}
            sizes="(max-width: 48rem) 100vw, 33vw"
          />
          <figcaption class="kicker">{caption}</figcaption>
        </figure>
      ))}
    </div>
  ) : (
    <div class="slot">
      <strong>Stills gallery.</strong> Drop rendering files into
      src/assets/stills/ — every image there shows up here automatically on
      the next build. Use descriptive kebab-case filenames; they become the
      captions.
    </div>
  )
}

<style>
  .stills {
    columns: 3;
    gap: clamp(1rem, 2vw, 1.5rem);
  }

  @media (max-width: 64rem) {
    .stills {
      columns: 2;
    }
  }

  @media (max-width: 40rem) {
    .stills {
      columns: 1;
    }
  }

  figure {
    break-inside: avoid;
    margin-bottom: clamp(1rem, 2vw, 1.5rem);
  }

  figure :global(img) {
    width: 100%;
    height: auto;
    border-radius: 2px;
  }

  figcaption {
    margin-top: 0.5rem;
    font-size: 0.72rem;
  }
</style>
