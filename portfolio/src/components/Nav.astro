---
import { Image } from 'astro:assets';
import mark from '../assets/brand/logo.png';
---

<header class="nav wrap">
  <a class="brand" href="#top" aria-label="Jason Layel — top of page">
    <Image src={mark} alt="" height={30} densities={[1, 2]} />
    <span class="wordmark">Jason Layel</span>
  </a>
  <nav aria-label="Main">
    <a href="#work">Work</a>
    <a href="#capabilities">Capabilities</a>
    <a href="#about">About</a>
    <a href="#contact" class="cta">Contact</a>
  </nav>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1rem;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
  }

  .brand :global(img) {
    height: 26px;
    width: auto;
  }

  .wordmark {
    font-weight: 660;
    font-stretch: 122%;
    font-size: 0.98rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    translate: 0 0.05em;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(0.8rem, 2.5vw, 2.25rem);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  nav a {
    color: var(--ink-muted);
    transition: color 160ms ease;
  }

  nav a:hover {
    color: var(--ink);
  }

  nav .cta {
    color: var(--accent);
  }

  nav .cta:hover {
    color: var(--ink);
  }

  @media (max-width: 30rem) {
    .wordmark {
      display: none;
    }
  }
</style>
