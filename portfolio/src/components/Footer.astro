---
const year = new Date().getFullYear();
---

<footer class="wrap">
  <p class="kicker">Jason Layel &mdash; Architectural Visualization</p>
  <p class="muted small">
    Ashburn, VA &middot; &copy; {year} &middot; Built with Astro, no trackers, no nonsense.
  </p>
</footer>

<style>
  footer {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: space-between;
    align-items: baseline;
    padding-block: 2.5rem;
    border-top: 1px solid var(--line);
  }

  .small {
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }
</style>
