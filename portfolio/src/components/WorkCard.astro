---
import type { CollectionEntry } from 'astro:content';
import ImageSlot from './ImageSlot.astro';

interface Props {
  entry: CollectionEntry<'work'>;
  index: number;
}

const { entry, index } = Astro.props;
const { title, category, summary, hero, heroAlt, isSlot } = entry.data;
const href = `${import.meta.env.BASE_URL}work/${entry.id}/`;
const num = String(index + 1).padStart(2, '0');
---

<a class="row" href={href}>
  <div class="media">
    <ImageSlot
      src={hero}
      alt={heroAlt || title}
      ratio="16 / 9"
      hint="Hero image, min 2000px wide"
    />
  </div>
  <div class="body">
    <div class="meta">
      <span class="num">{num}</span>
      <span class="cat">{category}</span>
      {isSlot && <span class="badge">slot</span>}
    </div>
    <h3>{title}</h3>
    <p class="muted">{summary}</p>
    <span class="arrow-link view">View case study</span>
  </div>
</a>

<style>
  .row {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
    padding-block: clamp(1.75rem, 4vw, 2.75rem);
    border-top: 1px solid var(--line);
  }

  .row:last-child {
    border-bottom: 1px solid var(--line);
  }

  @media (max-width: 46rem) {
    .row {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
  }

  .media :global(.img-frame) {
    transition: opacity 200ms ease;
  }

  .row:hover .media :global(.img-frame) {
    opacity: 0.85;
  }

  .body {
    display: grid;
    gap: 0.7rem;
    align-content: center;
  }

  .meta {
    display: flex;
    gap: 1rem;
    align-items: baseline;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .num {
    color: var(--ink-faint);
  }

  .cat {
    color: var(--accent);
  }

  .badge {
    color: var(--ink-faint);
    border: 1px dashed var(--ink-faint);
    padding: 0.1rem 0.5rem;
    border-radius: 2px;
  }

  h3 {
    font-size: var(--step-2);
    transition: color 160ms ease;
  }

  .row:hover h3 {
    color: var(--accent);
  }

  .body p {
    font-size: var(--step-0);
    line-height: 1.6;
  }

  .view {
    margin-top: 0.35rem;
  }
</style>
